    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Debug — log all keys to find exact names\nconst keys = Object.keys(data);\n\nlet score = 0;\n\nconst income = Number(Object.entries(data).find(([k]) => k.includes('Annual Income'))?.[1] || 0);\nconst loan = Number(Object.entries(data).find(([k]) => k.includes('Loan Amount'))?.[1] || 0);\nconst savings = Number(Object.entries(data).find(([k]) => k.includes('Savings'))?.[1] || 0);\nconst collateral = (Object.entries(data).find(([k]) => k.includes('Collateral'))?.[1] || '').toString().toUpperCase();\nconst purpose = (Object.entries(data).find(([k]) => k.includes('Loan Purpose'))?.[1] || '').toString().trim();\nconst defaults = (Object.entries(data).find(([k]) => k.includes('Previous Defaults'))?.[1] || '').toString().toUpperCase();\nconst name = (Object.entries(data).find(([k]) => k.includes('Full Name'))?.[1] || '').toString().trim();\n\n// C1 — Capacity\nconst lti = loan / income;\nif (lti < 0.3) score += 30;\nelse if (lti < 0.5) score += 20;\nelse score += 5;\n\n// C2 — Capital\nconst capitalRatio = savings / loan;\nif (capitalRatio > 0.5) score += 25;\nelse if (capitalRatio > 0.2) score += 15;\nelse score += 5;\n\n// C3 — Collateral\nif (collateral === 'NO') score += 5;\nelse score += 20;\n\n// C4 — Conditions\nif (purpose === 'Business') score += 15;\nelse if (purpose === 'Education') score += 12;\nelse score += 8;\n\n// C5 — Character\nif (defaults === 'YES') score -= 10;\nelse score += 10;\n\n// Risk rating\nlet rating;\nif (score >= 75) rating = 'LOW';\nelse if (score >= 45) rating = 'MEDIUM';\nelse rating = 'HIGH';\n\nreturn [{ json: {\n  name: name,\n  income: income,\n  loanAmount: loan,\n  score: score,\n  riskRating: rating,\n  timestamp: new Date().toISOString(),\n  debug_keys: keys.join(' | ')\n}}];"
      },
